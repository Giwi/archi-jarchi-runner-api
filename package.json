{
  "name": "archi-server",
  "version": "0.1.0",
  "private": true,
  "description": "HTTP API that runs Archi (headless) with jArchi + coArchi plugins",
  "type": "module",
  "license": "GPL-3.0-or-later",
  "author": "giwi.fr (https://giwi.fr)",
  "repository": {
    "type": "git",
    "url": "https://github.com/Giwi/archi-jarchi-runner-api.git"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "node --import tsx --test \"test/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
